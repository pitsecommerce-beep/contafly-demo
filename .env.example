# Fecha que usa toda la lógica de calendario de la demo
DEMO_FECHA=2026-11-13

# Supabase: solo URL y llave anon. La api escribe por funciones RPC; las tablas siguen cerradas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Twilio (opcional). Sin estas variables, WhatsApp y llamadas se simulan dentro de la web.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox: whatsapp:+14155238886. Producción: el remitente aprobado de Contafly
TWILIO_WHATSAPP_FROM=
TWILIO_SANDBOX_JOIN_CODE=
TWILIO_VOICE_FROM=

# Deepgram
DEEPGRAM_API_KEY=

# Anthropic (opcional). Sin llave, el contador responde con reglas fijas y las cifras del motor.
ANTHROPIC_API_KEY=
# Por defecto claude-opus-5-5
ANTHROPIC_MODEL=

# URLs públicas
PUBLIC_API_URL=
PUBLIC_WEB_URL=

# Token compartido entre web y api para las rutas /demo/* (cualquier texto largo y aleatorio)
DEMO_API_TOKEN=
# Secreto para firmar URLs de PDFs (por defecto usa TWILIO_AUTH_TOKEN o uno aleatorio)
SECRETO_URLS=
# Límites diarios por número
LIMITE_MENSAJES_DIA=60
LIMITE_LLAMADAS_DIA=3
LIMITE_DOCUMENTOS_DIA=10
